@{
    ViewData["Title"] = "Collaboration Rooms";
    var isGuest = User.FindFirst("IsGuest")?.Value == "true";
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Guest";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Collaboration Rooms</h4>
        <small class="text-muted">Public notes yang bisa diedit bersama</small>
    </div>
    @if (!isGuest)
    {
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> My Notes
        </a>
    }
</div>

<div class="alert alert-info d-flex align-items-center rounded-3 mb-4" role="alert">
    <i class="bi bi-person-circle me-2 fs-5"></i>
    <span>Masuk sebagai <strong>@displayName</strong>@(isGuest ? " (Guest)" : "")</span>
</div>

<div id="roomsContainer" class="row">
    <!-- Skeleton -->
    @for (int i = 0; i < 3; i++)
    {
        <div class="col-sm-6 col-lg-4 mb-4 skeleton-card">
            <div class="card" aria-hidden="true">
                <div class="card-body">
                    <h5 class="card-title placeholder-glow"><span class="placeholder col-6"></span></h5>
                    <p class="card-text placeholder-glow">
                        <span class="placeholder col-7"></span>
                        <span class="placeholder col-4"></span>
                    </p>
                    <a href="#" tabindex="-1" class="btn btn-primary disabled placeholder col-5"></a>
                </div>
            </div>
        </div>
    }
</div>

<div id="emptyRooms" class="d-none">
    <div class="alert alert-warning text-center rounded-4">
        <i class="bi bi-inbox me-2"></i> Belum ada public room. Admin belum membuat note public.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $.ajax({
                url: '/Collaboration/GetPublicNotes',
                type: 'GET',
                success: function (res) {
                    $(".skeleton-card").remove();

                    if (!res.success || !res.data || res.data.length === 0) {
                        $("#emptyRooms").removeClass("d-none");
                        return;
                    }

                    res.data.forEach(function (note) {
                        const entryCount = note.entries ? note.entries.length : 0;
                        const card = `
                            <div class="col-sm-6 col-lg-4 mb-4">
                                <div class="card card-border-shadow-primary h-100 cursor-pointer"
                                     onclick="window.location.href='/Collaboration/Room?noteId=${note.id}'">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-3">
                                            <span class="avatar-initial rounded bg-label-success me-3 p-2">
                                                <i class="bi bi-people-fill fs-5 text-success"></i>
                                            </span>
                                            <div>
                                                <h5 class="mb-0 fw-semibold">${note.title}</h5>
                                                <small class="text-muted">${entryCount} entry</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="badge bg-label-success rounded-pill">
                                                <i class="bi bi-unlock me-1"></i>Public Room
                                            </span>
                                            <span class="text-primary small fw-semibold">
                                                Masuk <i class="bi bi-arrow-right ms-1"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        $("#roomsContainer").append(card);
                    });
                    const docEditor = `
                     <div class="col-sm-6 col-lg-4 mb-4">
                         <div class="card card-border-shadow-primary h-100 cursor-pointer"
                              onclick="window.location.href='/Document/Editor'">
                             <div class="card-body">
                                 <div class="d-flex align-items-center mb-3">
                                     <span class="avatar-initial rounded bg-label-success me-3 p-2">
                                         <i class="bi bi-people-fill fs-5 text-success"></i>
                                     </span>
                                     <div>
                                         <h5 class="mb-0 fw-semibold">Testing Editor</h5>
                                         <small class="text-muted">For testing</small>
                                     </div>
                                 </div>
                                 <div class="d-flex align-items-center justify-content-between">
                                     <span class="badge bg-label-success rounded-pill">
                                         <i class="bi bi-unlock me-1"></i>Public Room
                                     </span>
                                     <span class="text-primary small fw-semibold">
                                         Masuk <i class="bi bi-arrow-right ms-1"></i>
                                     </span>
                                 </div>
                             </div>
                         </div>
                     </div>
                    `;
                    $("#roomsContainer").append(docEditor);
                },
                error: function () {
                    $(".skeleton-card").remove();
                    $("#roomsContainer").html(
                        `<div class="alert alert-danger">Gagal memuat rooms.</div>`
                    );
                }
            });
        });
    </script>
}
