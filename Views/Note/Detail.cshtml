@model NoteApp.Models.Note
@inject NoteApp.Services.IDailyEntryService _entryService
@{
    DateTime selectedDate = ViewBag.SelectedDate;
    var entry = ViewBag.Entry as NoteApp.Models.DailyEntry;
    ViewData["Title"] = "Detail";
}
<style>
    .flatpickr-input {
        font-size: 0.85rem; /* perkecil font */
        padding: 0.25rem 0.5rem; /* kecilkan padding */
        height: 30px; /* sesuaikan tinggi */
    }

    #tag-input:focus {
        outline: none;
        box-shadow: none;
    }

</style>
<div class="modal fade" id="addEntryModal" tabindex="-1" aria-labelledby="addEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="manualAddEntryForm" action="/Note/AddEntry">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pilih Tanggal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="NoteId" value="@Model.Id" />
                    <label for="newEntryDate" class="form-label">Tanggal</label>
                    <input type="date" name="Date" class="form-control" id="newEntryDate" required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Buat Entry</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="noteDetailContainer">
    <!-- AJAX akan inject form di sini -->
</div>


<!-- Share note Modal -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form id="shareForm" class="modal-content border-0 rounded-4 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-plus-circle me-2 text-primary"></i>Kirim Catatan By Email
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label for="Title" class="form-label fw-semibold">Subject</label>
                    <input type="text" class="form-control rounded-3" name="Subject" placeholder="Subject" required />
                </div>
                <div class="mb-3">
                    <label for="Title" class="form-label fw-semibold">Berbagi</label>
                    <div id="tag-container" class="d-flex flex-wrap border p-2 rounded mb-2 align-items-center">
                        <input id="tag-input" type="text" class="form-control flex-grow-1 rounded-3" placeholder="Ketik Email diikuti dengan ; untuk multiple" />  
                        <input id="tag-values" type="hidden" name="Email" class="form-control rounded-3" />
                    </div>

                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="submit" id="shareButtonModal" class="btn btn-primary rounded-pill">
                    <i class="bi bi-save me-1"></i>Kirim
                </button>
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Batal
                </button>
            </div>
        </form>
    </div>
</div>


<!-- Modal Success -->
<div class="modal fade" id="shareSuccessModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">
            <div class="modal-body text-success fw-bold text-center" id="successMessage">
                <!--success body-->
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modelId = "@Model.Id";
        var entryId = "";

        const url = new URL(window.location);
        var dateParam = url.searchParams.get("date");
        var selectedDateVar = (dateParam !== null && dateParam !== "")
            ? dateParam
            : selectedDateVar;

        function loadDetail(id, selectedDate, modelId) {
            
            var data = {};

            if (id !== "") {
                data.id = id;
            }

            if (modelId !== "") {
                data.noteId = modelId;
                data.date = selectedDate;
            }

            $.ajax({
                url: '/Note/GetDetailNote',
                type: "GET",
                data: data,
                beforeSend: function () {
                    $("#noteDetailContainer").html(`
                        <div class="p-4 text-center text-muted">Loading...</div>
                    `);
                },
                success: function (res) {
                    if (res.success) {
                        let entry = res.data;
                        if (!entry) {
                            $("#noteDetailContainer").html(`
                                <div class="misc-wrapper">
                                    <h1 class="mb-2 mx-2">Note is Empty</h1>
                                    <p class="mb-4 mx-2">You Can Create Note by button below</p>
                                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEntryModal">
                                        <i class="bi bi-calendar-plus"></i>&nbsp; Entry Baru
                                    </button>
                                </div>
                            `);
                        }
                        else{
                            const url = new URL(window.location);
                            url.searchParams.set("date", entry.date);

                            // Tambah ke riwayat browser
                            window.history.pushState({}, "", url);

                            var entryDate = moment(entry.date, "YYYY-MM-DD")

                            var formatedDate = moment(selectedDate, "DD/MM/YYYY HH:mm:ss")

                            var dateString = (entry.date !== null || entry.date) !== "" ? entryDate.format("DD MMM YYYY") : formatedDate.format("DD MMM YYYY");

                            let html = `
                            <div class="mb-4 d-flex justify-content-evenly card p-3">
                                <div class="w-100">
                                    <div class="row mb-2">
                                          <div class="col-2">
                                            <span class="form-control badge-lg bg-label-dark text-nowrap">
                                              <i class="bi bi-calendar-event me-1"></i> ${dateString}
                                            </span>
                                          </div>
                                          <div class="col-10">
                                            <input placeholder="Title"
                                                   class="form-control bold"
                                                   type="text" name="Title_Note"
                                                   value="${entry.title_Note ?? ""}" />
                                          </div>
                                    </div>

                                    <div class="row g-2 mb-2">
                                        <!-- Status Radio -->
                                        <div class="col-12 col-md-4">
                                            <div class="d-flex flex-wrap p-2 border rounded">
                                                ${renderStatus(entry.status_absen)}
                                            </div>
                                        </div>
                                        <!-- Input Time -->
                                        <div class="col-6 col-md-2">
                                            <input placeholder="Start Time" class="form-control time-picker"
                                                   type="time" name="WH_start" value="${entry.wH_start ?? ""}" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <input placeholder="End Time" class="form-control time-picker"
                                                   type="time" name="WH_end" value="${entry.wH_end ?? ""}" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <input placeholder="Overtime Start" class="form-control time-picker"
                                                   type="time" name="OT_start" value="${entry.oT_start ?? ""}" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <input placeholder="Overtime End" class="form-control time-picker"
                                                   type="time" name="OT_end" value="${entry.oT_end ?? ""}" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card rounded-4 shadow-sm">
                                <div class="card-body">
                                    <form method="post" id="entryForm">
                                        <input type="hidden" name="NoteId" value="${modelId}" />
                                        <input type="hidden" name="Date" id="dateNote" value="${dateString}" />
                                        <input type="hidden" name="Id" value="${entry.id ?? ""}" />

                                        <textarea class="min-vh-100" id="ContentEditor" name="Content">${entry.content ?? ""}</textarea>

                                        <div class="mt-3 mb-3 me-1 end-0 bottom-0 m-5 rounded-pill" style="position: fixed">
                                            <button type="submit" class="btn btn-primary me-3" id="submitBtn">
                                                <i class="bi bi-save me-1"></i> Simpan Catatan
                                            </button>
                                            <button type="button" data-title="${entry.title_Note}" data-datenote="${entry.date}" class="btn btn-success shadow-sm"
                                                    data-bs-toggle="modal" data-bs-target="#shareModal" id="shareNote">
                                                <i class="bi bi-send me-1"></i> Kirim
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            `;
                            $("#noteDetailContainer").html(html);
                        }
                            // pastikan tidak ada instance lama
                        if (tinymce.get("ContentEditor")) {
                            tinymce.get("ContentEditor").remove();
                        }

                        tinymce.init({
                            selector: '#ContentEditor',
                            menubar: false,
                            plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount autosave code fullscreen',
                            toolbar: 'saveButton | code fullscreen | myPageBreakButton | undo redo | blocks fontsize | bold italic forecolor removeformat | link image table | alignleft aligncenter alignright lineheight | numlist bullist indent outdent ',
                            branding: false,
                            images_upload_handler: function (blobInfo, progress) {
                              return new Promise((resolve, reject) => {
                                try {
                                    console.log(tinymce.majorVersion, tinymce.minorVersion);

                                    const mime = blobInfo.blob().type;
                                    const base64 = "data:" + mime + ";base64," + blobInfo.base64();

                                    // TinyMCE HARUS menerima { location: string }
                                    resolve(base64);
                                } catch (err) {
                                  reject("Gagal upload: " + err.message);
                                }
                              });
                            }
        ,
                            setup: function (editor){
                                //save all tiny
                                let activeNotification = null;
                                let handleSave = null;

                                handleSave = function () {
                                    const $btn = $("#submitBtn");
                                    const originalHtml = $btn.html();
                                    $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Menyimpan...`);

                                    const token = $('input[name="__RequestVerificationToken"]').val();
                                    const content = tinymce.get("ContentEditor").getContent();

                                    const isEdit = $("input[name='Id']").length > 0;
                                    const url = isEdit ? "/Note/UpdateEntry" : "/Note/AddEntry";

                                    // ⏳ Tampilkan notifikasi loading
                                    const loadingNotification = editor.notificationManager.open({
                                        text: 'Saving document... <i class="fas fa-spinner fa-spin"></i>',
                                        type: 'info',
                                        closeButton: false,
                                        timeout: 0 // notifikasi tidak akan hilang otomatis
                                    });

                                    $.ajax({
                                        type: "POST",
                                        url: url,
                                        data: {
                                            __RequestVerificationToken: token,
                                            Id: $("input[name='Id']").val(),
                                            NoteId: $("input[name='NoteId']").val(),
                                            Date: $("#dateNote").val(),
                                            Title_Note: $("input[name='Title_Note']").val(),
                                            WH_start: $("input[name='WH_start']").val(),
                                            WH_end: $("input[name='WH_end']").val(),
                                            OT_start: $("input[name='OT_start']").val(),
                                            OT_end: $("input[name='OT_end']").val(),
                                            Status_absen: $("input[name='Status_absen']:checked").val(),
                                            Content: content
                                        },
                                        success: function (response) {
                                            loadingNotification.close();

                                            // ✅ Tampilkan hasil sukses/gagal
                                            activeNotification = editor.notificationManager.open({
                                                text: response.message || 'Document saved',
                                                type: 'info',
                                                timeout: 0
                                            });
                                            $btn.prop("disabled", false).html(`<i class="bi bi-save me-1"></i> Simpan Catatan`);
                                        },
                                        error: function () {
                                            $btn.prop("disabled", false).html(originalHtml);
                                            alert("Terjadi kesalahan saat menyimpan.");
                                        }
                                    });
                                }


                                editor.ui.registry.addButton('saveButton', {
                                    text: 'Save Page',
                                    icon: 'save',
                                    onAction: handleSave
                                });

                                // 🎹 Shortcut Ctrl+S → panggil saveButton
                                editor.addShortcut("ctrl+s", "Save Content", function () {
                                  // ambil definisi tombol lalu jalankan onAction
                                  handleSave();
                                  return false; // cegah browser save page
                                });

                                // ✅ Tutup notifikasi kalau ada perubahan
                                editor.on('Change Input NodeChange KeyUp Paste Undo Redo', function () {
                                    if (activeNotification) {
                                        activeNotification.close();
                                        activeNotification = null;
                                    }
                                });


                            }
                        });

                        $('.time-picker').flatpickr({
                            enableTime: true,
                            noCalendar: true,
                            time_24hr: true,
                        });

                        $("input[name='Status_absen']").on("change", function () {
                            var statusAbsen = $("input[name='Status_absen']:checked").val();

                            if (statusAbsen === "1" || statusAbsen === "4") {
                                $('.time-picker').removeClass("d-none").addClass("d-block");
                            } else {
                                $('.time-picker').addClass("d-none").removeClass("d-block");
                            }
                        });

                    } else {
                        $("#noteDetailContainer").html(
                            `<div class="alert alert-warning">${res.message}</div>`
                        );
                    }
                },
                error: function () {
                    $("#noteDetailContainer").html(
                        `<div class="alert alert-danger">Terjadi kesalahan server</div>`
                    );
                }
            });
        }

        // helper untuk render radio status
        function renderStatus(selected) {
            const options = [
                { value: "1", label: "Masuk" },
                { value: "2", label: "Cuti" },
                { value: "3", label: "Libur" },
                { value: "4", label: "Lainnya" },
            ];
            return options.map(opt => `
                <div class="form-check me-2">
                    <input class="form-check-input" type="radio" name="Status_absen"
                           value="${opt.value}" ${selected == opt.value ? "checked" : ""} />
                    <label class="form-check-label">${opt.label}</label>
                </div>
            `).join("");
        }

        $(".listDateSidebar").on("click", function () {
            entryId = $(this).data("id"); // ambil nilai data-id

            loadDetail(entryId,selectedDateVar,modelId);
        });


        $(document).ready(function(){
            loadDetail(entryId,selectedDateVar,modelId);

            //input email
            const $container = $("#tag-container");
            const $input = $("#tag-input");
            const $hidden = $("#tag-values");

            function updateHidden() {
              let tags = [];
              $container.find(".tag-badge").each(function () {
                tags.push($(this).data("value"));
              });
              $hidden.val(tags.join(";"));
            }

            function addTag(text) {
              text = text.replace(";", "").trim();
              if (text !== "") {
                const badge = $(`
                  <span class="badge bg-label-dark tag-badge me-1 mb-1" data-value="${text}">
                    ${text} <i class="bi bi-x ms-1 remove-tag" style="cursor:pointer;"></i>
                  </span>
                `);
                badge.insertBefore($input);
                $input.val("");
                updateHidden();
              }
            }

            // Keydown ; atau Enter
            $input.on("keydown", function(e) {
              if (e.key === ";" || e.key === "Enter") {
                e.preventDefault();
                addTag($input.val());
              }
            });

            // Klik icon plus
            $("#add-tag-btn").on("click", function() {
              addTag($input.val());
            });

            // Hapus badge
            $container.on("click", ".remove-tag", function () {
              $(this).parent().remove();
              updateHidden();
            });
        });

        $(document).on("submit", "#entryForm", function (e) {
            e.preventDefault();

            const $btn = $("#submitBtn");
            const originalHtml = $btn.html();
            $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Menyimpan...`);

            const token = $('input[name="__RequestVerificationToken"]').val();
            const content = tinymce.get("ContentEditor").getContent();

            const isEdit = $("input[name='Id']").length > 0;
            const url = isEdit ? "/Note/UpdateEntry" : "/Note/AddEntry";

            $.ajax({
                type: "POST",
                url: url,
                data: {
                    __RequestVerificationToken: token,
                    Id: $("input[name='Id']").val(),
                    NoteId: $("input[name='NoteId']").val(),
                    Date: $("#dateNote").val(),
                    Title_Note: $("input[name='Title_Note']").val(),
                    WH_start: $("input[name='WH_start']").val(),
                    WH_end: $("input[name='WH_end']").val(),
                    OT_start: $("input[name='OT_start']").val(),
                    OT_end: $("input[name='OT_end']").val(),
                    Status_absen: $("input[name='Status_absen']:checked").val(),
                    Content: content
                },
                success: function () {
                    const noteId = $("input[name='NoteId']").val();
                    const date = $("#dateNote").val();
                    const id = $("input[name='Id']").val();
                    loadDetail(id, date,noteId);
                },
                error: function () {
                    $btn.prop("disabled", false).html(originalHtml);
                    alert("Terjadi kesalahan saat menyimpan.");
                }
            });
        });
        $(document).on("submit", "#manualAddEntryForm", function (e) {
            e.preventDefault();

            const token = $('input[name="__RequestVerificationToken"]').val();
            const noteId = $(this).find("input[name='NoteId']").val();
            const date = $(this).find("input[name='Date']").val();

            const $btn = $(this).find("button[type='submit']");
            const originalHtml = $btn.html();
            $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Membuat...`);

            $.ajax({
                type: "POST",
                url: "/Note/AddEntry",
                data: {
                    __RequestVerificationToken: token,
                    NoteId: noteId,
                    Date: date,
                    Content: "" // kosongkan, nanti bisa diedit di halaman detail
                },
                success: function () {
                    // Setelah berhasil insert, redirect ke halaman detail dengan tanggal tersebut
                    window.location.href = `/Note/Detail?id=${noteId}&date=${date}`;
                },
                error: function () {
                    $btn.prop("disabled", false).html(originalHtml);
                    alert("Gagal membuat entry.");
                }
            });
        });

        $(document).on("submit", "#shareForm", function (e) {

            e.preventDefault();

            const $btn = $("#shareButtonModal");
            $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Mengirim...`);


            var formData = new FormData(this);
            const content = tinymce.get("ContentEditor").getContent();
            const titleNote = $(this).data("title");
            const dateNote =  $(this).data("datenote");
            const parsedDate = moment(dateNote, "DD/MM/YYYY");
            const subject = `${titleNote}_${parsedDate.format("DD MMM YYYY")}`;
            formData.append('BodyMail', content);
            formData.append('Subject', subject)
            $.ajax({
                type: "POST",
                url: "/Note/ShareNote",
                data: formData,
                processData :false,
                contentType :false,
                success: function (response) {
                    if (response.success) {
                        // Tutup modal
                        $("#shareModal").modal('hide');
                        $("#successMessage").text(response.message);
                        $("#shareSuccessModal").modal('show');
                        $btn.prop("disabled", false).html(`<i class="bi bi-save me-1"></i>Kirim`);

                        setTimeout(function (){
                            $("#shareSuccessModal").modal('hide');    
                        }, 3000);
                    }
                },
                error: function(e){
                    alert("failed to update profile: " + e);
                    $btn.prop("disabled", false).html(`<i class="bi bi-save me-1"></i>Kirim`);

                }
            });
        });

    </script>
}
