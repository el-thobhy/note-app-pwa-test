@{
    ViewData["Title"] = "Semua Note";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <button class="btn btn-primary rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="bi bi-plus-circle me-1"></i> Tambah Note
    </button>
</div>
<hr />
<div id="page-content" style="display:none;">
    <div class="row" id="notesContainer">

        <!-- Skeleton -->
        <!-- Skeleton Loader -->
        <div id="skeleton-container" style="display:none;" class="container-fluid p-4">
            <div class="row">
                <!-- Main Content -->
                <div class="col-12">
                    <!-- Content cards skeleton -->
                    <div class="row">
                        <div class="col-sm-6 col-lg-4 col-md-3 mb-3">
                            <div class="card" aria-hidden="true">
                                <div class="card-body">
                                    <h5 class="card-title placeholder-glow">
                                        <span class="placeholder col-6"></span>
                                    </h5>
                                    <p class="card-text placeholder-glow">
                                        <span class="placeholder col-7"></span>
                                        <span class="placeholder col-4"></span>
                                        <span class="placeholder col-4"></span>
                                    </p>
                                    <a href="#" tabindex="-1" class="btn btn-primary disabled placeholder col-6"></a>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-4 col-md-3 mb-3">
                            <div class="card" aria-hidden="true">
                                <div class="card-body">
                                    <h5 class="card-title placeholder-glow">
                                        <span class="placeholder col-5"></span>
                                    </h5>
                                    <p class="card-text placeholder-glow">
                                        <span class="placeholder col-6"></span>
                                        <span class="placeholder col-8"></span>
                                    </p>
                                    <a href="#" tabindex="-1" class="btn btn-primary disabled placeholder col-4"></a>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-4 col-md-3 mb-3">
                            <div class="card" aria-hidden="true">
                                <div class="card-body">
                                    <h5 class="card-title placeholder-glow">
                                        <span class="placeholder col-5"></span>
                                    </h5>
                                    <p class="card-text placeholder-glow">
                                        <span class="placeholder col-6"></span>
                                        <span class="placeholder col-8"></span>
                                    </p>
                                    <a href="#" tabindex="-1" class="btn btn-primary disabled placeholder col-4"></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Skeleton end-->

        <div class="col-12" id="emptyMessage" style="display:none">
            <div class="alert alert-info text-center rounded-4 shadow-sm">
                <i class="bi bi-info-circle me-2"></i> Belum ada note. Tambahkan satu dengan tombol di atas.
            </div>
        </div>
    
    </div>
    <hr />
</div>


<!-- Modals -->
<div id="modalContainer">
    @await Html.PartialAsync("_NoteModals", new Note())
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // CREATE Note
        $("#createNoteForm").submit(function (e) {
            e.preventDefault();

            const $btn = $("#saveNote");
            const originalHtml = $btn.html();
            $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Menyimpan...`);

            var token = $('input[name="__RequestVerificationToken"]').val();
            var isPublic = $('#isPublicToggle').is(':checked');
            var title = $('#createNoteForm input[name="Title"]').val();

            console.log('IsPublic:', isPublic, 'Title:', title); // debug

            $.ajax({
                type: "POST",
                url: "/Home/Create",
                data: {
                    Title: title,
                    IsPublic: isPublic,
                    __RequestVerificationToken: token
                },
                success: function () {
                    $("#createModal").modal('hide');
                    $('#isPublicToggle').prop('checked', false); // reset toggle
                    location.reload();
                },
                error: function () {
                    $btn.prop("disabled", false).html(originalHtml);
                }
            });
        });

        // OPEN Edit Modal
        function openEditModal(id) {
            $.get("/Home/Edit/" + id, function (html) {
                $("#editModalContent").html(html);
                $("#editModal").modal('show');
            });
        }

        // OPEN Delete Modal
        function openDeleteModal(id, title) {
            $("#deleteNoteId").val(id);
            $("#deleteNoteTitle").text(title);
            $("#deleteModal").modal('show');
        }

        // DELETE Note
        $("#deleteNoteForm").submit(function (e) {
            //loading spinner
            const $btn = $("#deleteBtn");
            const originalHtml = $btn.html();
            $btn.prop("disabled", true).html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Menyimpan...`);

            e.preventDefault();
            const id = $("#deleteNoteId").val();
            $.post("/Home/DeleteConfirmed?id="+ id, function () {
              
                location.reload();
                $("#deleteModal").modal('hide');
            });
        });

        $(document).ready(function () {

            loadNotes();


            function loadNotes() {
                $("#skeleton-container").show();
                $.ajax({
                    url: '@Url.Action("GetDataHome", "Home")',
                    type: 'GET',
                    success: function (response) {
                        renderNotes(response);
                    },
                    error: function (response){
                        $("#notesContainer").html(
                            `<div class="alert alert-danger">Gagal Memuat Data : ${response.message}</div>`
                        );
                    }
                });
            }

            function renderNotes(response){
                let container = $("#notesContainer");
                container.empty();

                if(response.success){
                    $("#emptyMessage").hide();
                }else{
                    $("#emptyMessage").show();
                    return;
                }

                response.data.forEach(note => {
                    const publicBadge = note.isPublic
                        ? `<span class="badge bg-label-success rounded-pill ms-1" title="Public Room">
                               <i class="bi bi-people me-1"></i>Public
                           </span>`
                        : '';
                    const roomLink = note.isPublic
                        ? `<span class="text-success ps-2"
                                  onclick="event.stopPropagation(); window.location.href='/Collaboration/Room?noteId=${note.id}';"
                                  title="Buka Collaboration Room">
                               <i class="bi bi-people-fill"></i>
                           </span>`
                        : '';

                    container.append(`
                          <div class="col-sm-6 col-lg-4 mb-4 cursor-pointer">
                            <div class="card card-border-shadow-primary h-100"
                                 onclick="window.location.href='/Note/Detail?id=${note.id}'">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-1">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar me-2">
                                                <span class="avatar-initial rounded bg-label-primary"><i class="bx bxs-playlist"></i></span>
                                            </div>
                                            <h4 class="ms-1 mb-0 text-nowrap px-3">${note.entries.length} entry</h4>
                                            ${publicBadge}
                                        </div>
                                        <p class="mb-0 px-2">
                                            ${roomLink}
                                            <span class="text-warning ps-2"
                                                    onclick="event.stopPropagation(); openEditModal(${note.id});">
                                                <i class="bi bi-pencil-square"></i>
                                            </span>
                                            <span class="text-danger ps-2"
                                                    onclick="event.stopPropagation(); openDeleteModal(${note.id}, '${note.title}');">
                                                <i class="bi bi-trash3"></i>
                                            </span>
                                        </p>
                                    </div>
                                    <p class="mb-1">${note.title}</p>
                                </div>
                            </div>
                        </div>
                    `);
                });

                $("#page-content").show();
                container.show();

                $("#skeleton-container").hide();
            }

           
        });

    </script>
}
